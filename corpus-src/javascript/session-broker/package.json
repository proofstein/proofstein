{
  "name": "session-broker",
  "version": "3.1.0",
  "description": "Issues sealed sessions and signs the tokens that reference them",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js --config config/broker.yaml"
  },
  "dependencies": {
    "@noble/post-quantum": "0.6.1",
    "node-forge": "1.3.1" //@PS js-dep-forge|node-forge|5|algorithm|declared crypto dependency (provides RSA-OAEP, AES, X.509); only used by the 2.x migration script, which is not shipped
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  },
  "license": "Apache-2.0",
  "private": true
}
