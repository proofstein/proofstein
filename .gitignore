# Holdout material is generated per run and not committed.
/holdout/
/ground-truth-holdout/

# Build artifacts produced by tools/build-all.sh inside the corpus projects.
corpus/**/target/
corpus/**/node_modules/
corpus/**/dist/
corpus/**/__pycache__/
corpus/**/.venv/
corpus/**/*.o
corpus/**/*.class
corpus/c/tinyattest/tinyattest
corpus/c/tinyattest/tinyattest-cng.dll
corpus/go/beacon-relay/beacon-relay

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Scoring output for local runs. Published runs are under runs/<run-id>/.
/results/results.md
/results/results.json

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/

# A run's scratch directory.
runs/*/.work/

# Editor/agent local state
.claude/
